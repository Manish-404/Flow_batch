{
  "manifest_version": 3,
  "name": "FlowBatch — Bulk Generator for Google Flow & Gemini",
  "short_name": "FlowBatch",
  "version": "1.1.0",
  "description": "Bulk-run prompts with reference images in Google Flow or Gemini, auto-download each result, and extract or split video.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open FlowBatch",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "downloads", "tabs", "scripting", "tabCapture"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*", "https://*.flow.google.com/*", "https://labs.google/fx/*"],
      "js": ["content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://flow.google.com/*", "https://*.flow.google.com/*", "https://labs.google/fx/*"],
      "js": ["content/dom.js", "content/flow-agent.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/dom.js", "content/gemini-agent.js"],
      "run_at": "document_idle"
    }
  ]
}
