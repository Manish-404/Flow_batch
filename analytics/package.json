{
  "name": "flowbatch-stats",
  "private": true,
  "description": "FlowBatch usage stats endpoint (Cloudflare Worker + D1, free plan)",
  "scripts": {
    "db:local": "wrangler d1 execute flowbatch-stats --local --file schema.sql",
    "dev": "wrangler dev --local",
    "db:remote": "wrangler d1 execute flowbatch-stats --remote --file schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.143.0"
  }
}
