# Normalise text to LF in the repository; Git still checks out native endings.
* text=auto eol=lf

*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf

*.png binary

# Leave the website and its media out of GitHub's "Download ZIP", so the download is just the extension
/docs export-ignore
